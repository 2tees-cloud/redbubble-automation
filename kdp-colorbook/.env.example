# Скопируйте в .env и вставьте ключи. Пустое значение = провайдер отключён.

# ---------- ТЕКСТ ----------
# aistudio.google.com/apikey
GEMINI_API_KEY=
# console.groq.com/keys
GROQ_API_KEY=
# cloud.cerebras.ai
CEREBRAS_API_KEY=
# z.ai
ZAI_API_KEY=
# console.mistral.ai
MISTRAL_API_KEY=
# openrouter.ai/keys
OPENROUTER_API_KEY=
# console.x.ai
XAI_API_KEY=

# ---------- КАРТИНКИ ----------
# dash.cloudflare.com → AI → Workers AI → Use REST API (Account ID + токен с правом Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# huggingface.co/settings/tokens
HF_TOKEN=
# необязательно, без него Pollinations работает с жёстким лимитом
POLLINATIONS_TOKEN=

# ---------- ИССЛЕДОВАНИЕ НИШ ----------
# необязательно: keepa.com → API (~€49/мес). С ключом BSR и отзывы берутся из Keepa, без капчи Amazon
KEEPA_API_KEY=

# ---------- KDP-РОБОТ ----------
# необязательно: если сессия истекла, робот попробует войти сам (при 2FA всё равно нужен scripts/kdp_login.py)
KDP_EMAIL=
KDP_PASSWORD=

# ---------- УВЕДОМЛЕНИЯ ----------
# приложение ntfy (Android/iOS) → подписаться на свой топик; придумайте длинное случайное имя
NTFY_TOPIC=
# или Telegram: бот от @BotFather + ваш chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
